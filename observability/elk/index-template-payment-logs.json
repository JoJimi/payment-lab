{
  "index_patterns": ["payment-logs*"],
  "data_stream": {},
  "priority": 500,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.lifecycle.name": "payment-logs-ilm"
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "message": { "type": "text" },
        "ecs.version": { "type": "keyword" },
        "log.level": { "type": "keyword" },
        "log.logger": { "type": "keyword" },
        "process.pid": { "type": "long" },
        "process.thread.name": { "type": "keyword" },
        "service.name": { "type": "keyword" },
        "service.environment": { "type": "keyword" },
        "service.version": { "type": "keyword" },
        "event.dataset": { "type": "keyword" },
        "error.type": { "type": "keyword" },
        "error.message": { "type": "text" },
        "error.stack_trace": { "type": "text" },
        "traceId": { "type": "keyword" }
      }
    }
  },
  "_meta": {
    "description": "4.2 — payment-lab 로그 데이터 스트림(ECS). Filebeat(4.3)가 여기에 적재한다. RAG용 payment-incidents/payment-knowledge 인덱스는 4단계 범위 제외로 별도 생성하지 않는다."
  }
}
