{
  "title": "Payment Lab - 1단계 개요",
  "uid": "payment-lab-stage1",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "TPS (요청/초, URI별)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job, uri)",
          "legendFormat": "{{job}} {{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 응답시간",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, job, uri))",
          "legendFormat": "{{job}} {{uri}} p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "결제 성공/실패/UNKNOWN 비율",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(payment_result_total{job=\"payment-service\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "멱등성 히트율 (hit vs miss)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(idempotency_requests_total{job=\"payment-service\"}[1m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "재고 락 대기 시간 (평균, 전략별)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "1000 * sum(rate(inventory_lock_wait_seconds_sum{job=\"inventory-service\"}[1m])) by (strategy) / sum(rate(inventory_lock_wait_seconds_count{job=\"inventory-service\"}[1m])) by (strategy)",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "3.8 — 서킷 상태 전이 (mockPg)",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [] },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "always" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"mockPg\", job=\"payment-service\"} > 0",
          "legendFormat": "{{state}}"
        }
      ]
    }
  ]
}
